# ============================================================
# TRI_FUSION_BOARD_SYSROOT_SELECT_BLOCK
# Board-specific sysroot selection.
# The real sysroot must be passed by each board build script.
# Example:
#   Lindi      : -DTRI_TARGET_BOARD=lindi
#   Chuanglong : -DTRI_TARGET_BOARD=chuanglong
# ============================================================
set(TRI_TARGET_BOARD "unknown" CACHE STRING "Target board name")

if(DEFINED TRI_FUSION_TARGET_SYSROOT AND NOT "${TRI_FUSION_TARGET_SYSROOT}" STREQUAL "")
    set(TRI_FUSION_BUILDROOT_SYSROOT
        "${TRI_FUSION_TARGET_SYSROOT}"
        CACHE PATH "Target board Buildroot sysroot"
        FORCE
    )
elseif(DEFINED CMAKE_SYSROOT AND NOT "${CMAKE_SYSROOT}" STREQUAL "")
    set(TRI_FUSION_BUILDROOT_SYSROOT
        "${CMAKE_SYSROOT}"
        CACHE PATH "Target board Buildroot sysroot"
        FORCE
    )
else()
    message(FATAL_ERROR
        "TRI_FUSION_BUILDROOT_SYSROOT is not set. "
        "Please pass -DTRI_FUSION_TARGET_SYSROOT=/path/to/board/sysroot "
        "from the board-specific build script."
    )
endif()

message(STATUS "TRI_TARGET_BOARD=${TRI_TARGET_BOARD}")
message(STATUS "TRI_FUSION_BUILDROOT_SYSROOT=${TRI_FUSION_BUILDROOT_SYSROOT}")

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

option(TRI_FUSION_BUILD_TOOLS "Build L1 hardware probe tools" ON)
option(TRI_FUSION_BUILD_TESTS "Build smoke tests" ON)

find_package(OpenSSL QUIET)
if(OpenSSL_FOUND)
    message(STATUS "OpenSSL found: ${OPENSSL_VERSION}")
else()
    message(WARNING "OpenSSL not found in cross sysroot; GB28181/RTSP OpenSSL-dependent targets will be skipped.")
endif()

# ============================================================
# GStreamer / RGA dependencies for appsrc/appsink fusion runtime
# ============================================================
find_package(PkgConfig QUIET)
