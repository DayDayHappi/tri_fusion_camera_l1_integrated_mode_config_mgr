    NAMES OpenCL
    PATHS
        ${CMAKE_SYSROOT}/usr/lib
        ${CMAKE_SYSROOT}/usr/lib/aarch64-linux-gnu
        ${TRI_FUSION_BUILDROOT_SYSROOT}/usr/lib
        ${TRI_FUSION_BUILDROOT_SYSROOT}/usr/lib/aarch64-linux-gnu
)

