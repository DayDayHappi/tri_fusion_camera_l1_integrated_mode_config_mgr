    ss << "v4l2src device=" << opt.visibleDevice << " io-mode=mmap "
       << "! image/jpeg,width=" << opt.visibleWidth
       << ",height=" << opt.visibleHeight
       << ",framerate=" << opt.fps << "/1 "
